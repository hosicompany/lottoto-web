---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { latest } from '../lib/data';
---

<Base title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다." path="/404">
  <section class="card hero" style="margin-top:12px;text-align:center;padding:40px 20px">
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="date">회차 번호가 범위 밖이거나 주소가 바뀌었을 수 있습니다.</p>
    <div class="actions" style="justify-content:center">
      <a class="btn btn-primary" href={u(`/round/${latest.round}`)} style="flex:none">최신 회차 보기</a>
      <a class="btn btn-soft" href={u('/all')}>전체 회차</a>
    </div>
  </section>
</Base>
